# Factory OS — переменные окружения.
# Скопируй в .env и впиши реальные значения. .env в гит НЕ коммитится — секреты переноси отдельно.

# Postgres (Neon в облаке или локально). Та же строка, что на основном устройстве — иначе другие данные.
DATABASE_URL=postgresql://user:password@host/dbname

# HTTP-сервер (отдаёт API и статику Mini App)
PORT=3100

# Окружение. На любом задеплоенном/публичном сервере — ВСЕГДА production.
# Локальная разработка: поставь development (только это включает dev-вход ниже).
# Если переменная не задана — приложение считает окружение production (fail-closed).
NODE_ENV=production

# Dev-вход по Telegram ID без подписи Telegram. ТОЛЬКО для локальной разработки.
# Работает лишь когда ОДНОВРЕМЕННО NODE_ENV=development И тут стоит 1.
# На публичном сервере держи 0 (или убери совсем): при NODE_ENV=production со значением 1
# приложение НЕ запустится — это защита от случайного включения dev-входа на проде.
ENABLE_DEV_AUTH=0

# 1 — старый compat-слой (public/), 0 — новый React Mini App (web/dist). Обычно 0.
# Вне development должен быть задан явно.
SERVE_DESIGN=0

# Токен бота от @BotFather. Пусто — режим только API (бот/уведомления выключены).
# Только на сервере — НИКОГДА не отдавать во frontend.
BOT_TOKEN=

# Публичный HTTPS-адрес для кнопки Mini App в Telegram. Локально можно не задавать
# (по умолчанию http://localhost:PORT).
APP_URL=

# Секреты — ОБЯЗАТЕЛЬНЫ, ≥16 символов, НЕ плейсхолдеры (значения с change_me / dev_only
# отклоняются при старте). Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# «Перец» для PIN: при смене старые PIN перестанут подходить.
PIN_PEPPER=

# Пароль для закрытого Snabbase dashboard по адресу /snab-dashboard.
# На production задай длинный уникальный пароль.
SNAB_DASHBOARD_PASSWORD=
